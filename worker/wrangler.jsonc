{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lift-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "api.lift.garrett.one", "custom_domain": true }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://api.lift.garrett.one",
    "TRUSTED_ORIGINS": "https://lift.garrett.one,mobile://"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "ratelimits": [
    {
      "name": "DELETION_RATE_LIMITER",
      "namespace_id": "1183602647",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "SYNC_RATE_LIMITER",
      "namespace_id": "1183602648",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "EXPENSIVE_RATE_LIMITER",
      "namespace_id": "1183602649",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "liftdb",
      "database_id": "534e715a-a175-43b5-b743-f395c1336f5c",
      "migrations_dir": "migrations"
    }
  ]
}
